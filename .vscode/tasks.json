{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build:frontend",
            "type": "shell",
            "command": "npm run build", // 或者使用你自定义的脚本
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "problemMatcher": []
        },
        {
            "label": "wails:pre-debug",
            "dependsOn": [
                "build:frontend"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}