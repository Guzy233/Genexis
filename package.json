{
  "name": "mindgraph-root",
  "private": true,
  "description": "MindGraph Workspace Root",
  "scripts": {
    "install-all": "pnpm install",
    "build-all": "pnpm -r build",
    "build-plugins": "pnpm --filter \"./plugins/**\" build",
    "dev-plugins": "pnpm --parallel --filter \"./plugins/**\" build --watch"
  }
}
